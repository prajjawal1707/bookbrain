# ── OPTION 1: Ollama (100% local, completely free) ────────
# Install: https://ollama.com/download
# Then run: ollama pull llama3.2
# No API key needed!
# AI_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2

# ── OPTION 2: Groq (free tier, very fast) ─────────────────
# Get free key: https://console.groq.com (no credit card)
AI_PROVIDER=groq
GROQ_API_KEY=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
GROQ_MODEL=llama-3.3-70b-versatile

# ── OPTION 3: OpenRouter (free models available) ──────────
# Get free key: https://openrouter.ai (free credits on signup)
# AI_PROVIDER=openrouter
# OPENROUTER_API_KEY=sk-or-your-key-here
# OPENROUTER_MODEL=meta-llama/llama-3.2-3b-instruct:free

# ── OPTION 4: HuggingFace Inference API (free tier) ───────
# Get free key: https://huggingface.co/settings/tokens
# AI_PROVIDER=huggingface
# HF_API_KEY=hf_your_free_token_here
# HF_MODEL=mistralai/Mistral-7B-Instruct-v0.3

# ── Server ─────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
